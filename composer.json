{
    "name": "forge-ops/tracker",
    "description": "ForgeOps error tracking client: captures unhandled exceptions (Laravel/Symfony integration, plus explicit capture anywhere else) and delivers them to a ForgeOps instance over HTTP.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "laravel/framework": "^11.0 || ^12.0",
        "orchestra/testbench": "^9.0 || ^10.0",
        "symfony/http-kernel": "^7.0",
        "symfony/event-dispatcher": "^7.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "ForgeOps\\Tracker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ForgeOps\\Tracker\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
